"main()
{
  shape table=getShape(\"TABLE1\");

dyn_string d1, d2, d3;

dyn_dyn_string fnam, snam;

// The entries in the Forename column

d1=makeDynString(\"Peter\");

d2=makeDynString(\"Martin\");

d3=makeDynString(\"Christian\");

// Transfer to the dyn_dyn array

fnam[1]=d1;

fnam[2]=d2;

fnam[3]=d3;

// The entries in the Surname column

d1=makeDynString(\"Baker\");

d2=makeDynString(\"Miller\");

d3=makeDynString(\"Smith\");

// Transfer to the dyn_dyn array

snam[1]=d1;

snam[2]=d2;

snam[3]=d3;

// Appending the three lines

table.appendLines(3,\"Forename\",fnam,\"Surname\",snam);
}" 0
