"DragDrop" "main(string information, int dragType)
{
  shape sh = getShape(myModuleName(), \"main_pnl\", \"SELECTION_LIST1\");
  DebugN(\"Drag and Dropped: \" + information);
  sh.appendItem(\"Drag and Drop: \");
  sh.appendItem(information);
  delay(1);
}"
