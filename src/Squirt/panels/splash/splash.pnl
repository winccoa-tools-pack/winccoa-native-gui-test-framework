"main(mapping event)
{
  DebugTN(event);
  string sTC = txtTestCase.text, sFile = txtPanelSelected.text;

  if (sTC.isEmpty() || sFile.isEmpty())
  {
    throwError(makeError(\"\", PRIO_WARNING, ERR_CONTROL, 54, \"The test case or selected file is empty\", sTC, sFile));
    return;
  }

//   triggerEvent(self.splashStateChange, eSplash::record);
  DebugTN(\"spSplash start rec now\", spSplash);

  spSplash.record(sTC, sFile, txtParams.text);
//   triggerEvent(self.splashStateChange, eSplash::stop);
  DebugTN(\"rec finished\");
}
