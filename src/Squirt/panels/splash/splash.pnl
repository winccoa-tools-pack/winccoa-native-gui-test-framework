"main()
{
  uiConnect(\"workCB_selChanged\", self.selectionChanged);
  uiConnect(\"workCB_splashStateChanged\", self.splashStateChange);

    dyn_string dsFiles;
  string pat = \"*.ctl\";

  string absPath = spSplash.getScriptPath();

// DebugN(\"absPath\", absPath);
  string relPath = \"\";

DebugN(\"path\",absPath, spSplash.getScriptPath(), spSplash);
  getFilesRecursive(dsFiles, absPath, relPath, pat);

  //remvoe \"/splashRecord.ctl\"
  int iPos = dynContains(dsFiles, \"/splashRecord.ctl\");
  if (iPos > 0)
    dynRemove(dsFiles, iPos);

  tTestScripts.addColumn(\"\");
  tTestScripts.addColumn(\"tests\");
  tTestScripts.alternatingRowColors(true);
  tTestScripts.setColumnWidthMode(1, TREE_WIDTH_STRETCH);
  tTestScripts.addColumn(\"files\");
  tTestScripts.addColumn(\"params\");

  addDynToTree(dsFiles);

  //add files without tests

  pat = \"*.[px][nm][l]\";
  absPath = getPath(PANELS_REL_PATH);
  relPath = \"\";

  dynClear(dsFiles);
  getFilesRecursive(dsFiles, absPath, relPath, pat);

  for (int i = dynlen(dsAdditionalPanels); i > 0; i--)
  {
    dynInsertAt(dsFiles, dsAdditionalPanels[i], 1);
  }

      //remove panel extension

  for (int i = dynlen(dsFiles); i > 0; i--)
  {
    if (patternMatch(\"/splash/*\", dsFiles[i]))
    {
      dynRemove(dsFiles, i);
    }
    string s = dsFiles[i];
    if (s.lastIndexOf(\".\") < 0)
      continue;

    int iPos = s.length()- s.lastIndexOf(\".\");

    if (iPos >0)
      s.chop(iPos);

    dsFiles[i] = s;
  }

  addDynToTree(dsFiles, TRUE);

  tTestScripts.setSorting(0,true);
}

workCB_selChanged(string sFile, string sParams, string sTC)
{
  setMultiValue(\"txtPanelSelected\", \"text\", sFile,
                \"txtTestCaseReplay\", \"text\", sTC,
                \"txtParams\", \"text\", sParams);

  if (sTC != \"\") //for recording, do not reset TC
    txtTestCase.text = sTC;
}

workCB_splashStateChanged(eSplash splashState)
{
  bool bPlay, bRec, bStop;
  switch(splashState)
  {
    case eSplash::play:
      bPlay = 0;
      bRec = 0;
      bStop = 1;
      break;
    case eSplash::record:
      bPlay = 0;
      bRec = 0;
      bStop = 1;
      break;
    case eSplash::stop:
      bPlay = 1;
      bRec = 1;
      bStop = 0;
      break;
  }
  setMultiValue(\"pbPlay\", \"enabled\", bPlay,
                \"pbRec\",  \"enabled\", bRec,
                \"pbStop\", \"enabled\", bStop);
}


addDynToTree(dyn_string &dsFiles, bool bPanelsOnly = FALSE)
{
  for (int i = 1; i <= dynlen(dsFiles); i++)
  {
    //remove recorder panels
//     if (patternMatch(\"/splash/*\", dsFiles[i]))
//       continue;

    dyn_string dsSplit = strsplit(dsFiles[i], \"/\"); // first element is empty because paths starting with /
    if(!bPanelsOnly)DebugN(\"files\",dsSplit, dsFiles[i]);

    string sPath, sParent, sParentPath;
    for (int j = 2; j <= dynlen(dsSplit); j++)
    {
      sParentPath += \"/\" + dsSplit[j];
      if (sPath != \"\")
        sPath += \"_\";

      sPath += dsSplit[j];
      if (!mappingHasKey(mFiles, sPath))
      {
        tTestScripts.appendItemNC(sParent, sPath, dsSplit[j]);
        if (!bPanelsOnly && j==dynlen(dsSplit)) //test script names
          tTestScripts.setText(sPath, 1,  dsSplit[j]); //test col
        if (bPanelsOnly && j==dynlen(dsSplit)) //panel file
          tTestScripts.setText(sPath, 2, dsFiles[i]); //file col
        else if (!bPanelsOnly && j>=dynlen(dsSplit)-1) //panel file or script file
        {
          if (j==dynlen(dsSplit)) //script
          {
            tTestScripts.setText(sPath, 2, dsFiles[i]); //file col
            tTestScripts.setText(sPath, 3, bPanelsOnly ? \"\" : spSplash.getParamsFromScript(dsFiles[i]) ); //parameter col
          }
          else //replace script by panel
          {
            string sPanel = dsFiles[i]; //without panel extenstion

            tTestScripts.setText(sPath, 2, sParentPath); //file col
          }
        }

        eNodeType nodeType;

        if (bPanelsOnly)
        {
          nodeType = j==dynlen(dsSplit) ? eNodeType::panel : eNodeType::folder;
        }
        else //with existing test scripts below
        {
          if (j==dynlen(dsSplit)) //script
            nodeType = eNodeType::script;
          else if (j==dynlen(dsSplit)-1) //panel
            nodeType = eNodeType::panelWithScripts;
          else //folder with scripts
             nodeType = eNodeType::folderWithScripts;

        }

        setNodeIcon(sPath, nodeType);

        mFiles[sPath] = i==dynlen(dsFiles) ? dsFiles[i] : \"\";

      }
      sParent = sPath;
    }
  }
