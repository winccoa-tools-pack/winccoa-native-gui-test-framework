work(string s, string cmd)
{
  this.text = cmd;
  if( patternMatch(spSplash.sCmdFinished + \"*\", cmd) )
  {
    if (!isAnswer())
      reactOnFinish();
  }

  triggerEvent(self.splashStateChange, spSplash.getStateFromString(cmd));
}
