""0  1
E "#uses \"classes/splash/Splash\"
#event selectionChanged(string sFile, string sParams, string sTC)
#event splashStateChange(eSplash splashState)

mapping mFiles;
shared_ptr<Splash> spSplash  = new Splash(FALSE); //ready for replay controll
const dyn_string dsAdditionalPanels = makeDynString(\"/vision/login.pnl\" /*, \"/vision/loginFramework/login_Standard.pnl\"*/);

enum eNodeType
{
  folder,
  folderWithScripts,
  panel,
  panelWithScripts,
  script
};

reactOnFinish()
{
  string sTC = txtTestCase.text;
  if (!patternMatch(\"*.ctl\", sTC))
    sTC += \".ctl\";

  txtTestCaseReplay.text = sTC;
  updateNode(sTC, txtPanelSelected.text, txtParams.text);
  triggerEvent(self.splashStateChange, eSplash::stop);
}

updateNode(string sTC, string sPanel, string sParams)
{
  string sParent, sNode, sFile;
  strreplace(sPanel, \"\\\\\", \"/\");

  if (!patternMatch(\"*.ctl\", sTC))
    sTC+=\".ctl\";

  string sTotalPath = txtPanelSelected.text + \"/\" + sTC;

  getNodeIdFromFilePath(sPanel, sParent, sNode, sFile);
  if (!mappingHasKey(mFiles, sNode)) //panel
  {
//     DebugN(\"add node\", sParent, sNode, sFile, mFiles);
    tTestScripts.appendItem(sParent, sNode, sFile);
    setNodeIcon(sNode, eNodeType::panelWithScripts);

    mFiles[sNode] = sPanel;
  }
  else //panel update
  {
    setNodeIcon(sNode, eNodeType::panelWithScripts);
  }

  //TC
  getNodeIdFromFilePath(sTotalPath, sParent, sNode, sFile);
  if (!mappingHasKey(mFiles, sNode))
  {
    DebugN(\"add node 2\", sParent, sNode, sFile, mFiles);
    tTestScripts.appendItem(sParent, sNode, makeDynString(sFile, sFile, sTotalPath));
    //icon and cols
    setNodeIcon(sNode, eNodeType::script);

    mFiles[sNode] = sPanel;
    tTestScripts.setText(sNode, 3, sParams ); //parameter col
  }
  if (sNode != \"\")
    tTestScripts.setSelectedItem(sNode, true);
//     tTestScripts.selectedItem(sNode);
}

getNodeIdFromFilePath(string sPath, string &sParent, string &sNode, string &sFile)
{
  strreplace(sPath, \"\\\\\", \"/\");
  dyn_string dsSplit = strsplit(sPath, \"/\");
  if (dynlen(dsSplit)>0 && dsSplit[1]==\"\")
    dynRemove(dsSplit, 1);
  string sId;

  int iLen = dynlen(dsSplit);
  if (iLen == 0)
    return;

  sNode = \"\";

  for (int i = 1; i <= iLen; i++)
  {
    if (i == iLen)
      sParent = sNode;

    if (i>1)
      sNode += \"_\";

    sNode += dsSplit[i];
  }
  sFile = dsSplit[iLen];
}

setNodeIcon(string sNode, eNodeType nodeType)
{
  string sIcon;

  switch(nodeType)
  {
    case eNodeType::folder:
      sIcon = \"folder.png\";
      break;
    case eNodeType::folderWithScripts:
      sIcon = \"wf/stylesheet/folder.png\";
      break;
    case eNodeType::panel:
      sIcon = \"ProjectView/file.png\";
      break;
    case eNodeType::panelWithScripts:
      sIcon = \"newpanel.png\";
      break;
    case eNodeType::script:
    default:
      sIcon = \"scripteditor.png\";
      break;
  }
  tTestScripts.setIcon(sNode, 0, sIcon);
}
