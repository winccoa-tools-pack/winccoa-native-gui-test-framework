"
string sModule = myModuleName();


main()
{
  bool bRecording = TRUE;
  if(isDollarDefined(\"$MODEREC\"))
  {
    bRecording = getDollarValue(\"$MODEREC\");
  }
  const string sColorRec = \"<{250,0,4,127},8,{250,0,4,0},4>\";
  const string sColorReplay = \"green\";
DebugN(\"recording=?\",bRecording);
  RECTANGLE1.foreCol = bRecording ? sColorRec : sColorReplay;

  string flags = self.windowFlags + \"|FramelessWindowHint\";
  self.windowFlags = flags;
  DebugN(\"windowFlags=\"+self.windowFlags);
  startThread(\"getInFront\");
  moduleShowFullScreen(sModule);
  delay(1);
  moduleShowFullScreen(sModule);
}

getInFront()
{

  while(1)
  {
    moduleRaise(sModule);
//     if (isModuleOpen(\"Vision_1\"))
    delay(0,500);
  }
}
