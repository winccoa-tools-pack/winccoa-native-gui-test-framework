 <properties>
  <prop name="Name">
   <prop name="en_US.utf8">DPE Monitor 010 Recording Guide</prop>
  </prop>
  <prop name="Size">616 348</prop>
  <prop name="BackColor">WF_PanelBackground</prop>
  <prop name="RefPoint">0 0</prop>
  <prop name="InitAndTermRef">False</prop>
  <prop name="SendClick">False</prop>
  <prop name="RefFileName"></prop>
  <prop name="KeepInMemory">False</prop>
  <prop name="Type">WF</prop>
  <prop name="DPI">96</prop>
  <prop name="PDPI">96</prop>
  <prop name="layoutType">HBox</prop>
 </properties>
 <events>
  <script isEscaped="1" name="ScopeLib"><![CDATA[void stopSelectorRecording()
{
  if (g_stopCommandSent)
    return;

  string macroName = macroNameInput.text;
  string libraryPath = libraryPathInput.text;

  if (macroName == &quot;&quot; || libraryPath == &quot;&quot;)
    return;

  dpSetWait(&quot;_Splash.command&quot;, &quot;stop|&quot; + macroName + &quot;|&quot; + libraryPath,
            &quot;_Splash.response&quot;, &quot;&quot;);
  g_stopCommandSent = TRUE;
}

bool g_stopCommandSent = FALSE;
]]></script>
  <script isEscaped="1" name="Close"><![CDATA[main()
{
  stopSelectorRecording();
}]]></script>
  <script isEscaped="1" name="Initialize"><![CDATA[main()
{
  if (isfile(PROJ_PATH + &quot;.tcQuide.json&quot;))
  {
    string json;
    fileToString(PROJ_PATH + &quot;.tcQuide.json&quot;, json);
    mapping jsonData = jsonDecode(json);

    macroNameInput.text(jsonData.value(&quot;macroName&quot;, &quot;macro_&quot;));
    libraryPathInput.text(jsonData.value(&quot;libraryPath&quot;, &quot;macros.ctl&quot;));
    libraryPathInput.toolTipText(tr(&quot;Relative path to $1&quot;).subst(PROJ_PATH + SCRIPTS_REL_PATH));
    guideText.text(jsonData.value(&quot;quide&quot;, &quot;....&quot;));
  }
}
]]></script>
 </events>
